# Copy to .env; replace both local database passwords before starting.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_PORT=8080
BASE_URL=http://localhost:8080
COOKIE_SECURE=false
STORAGE_MODE=local
# Optional cloud storage. Leave blank for local mode.
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_MODE=smtp
MAIL_FROM=cloudvault@example.test
BREVO_API_KEY=
DEMO_ENABLED=true
MAX_ACCOUNTS=30
GLOBAL_LIMIT_BYTES=2147483648
